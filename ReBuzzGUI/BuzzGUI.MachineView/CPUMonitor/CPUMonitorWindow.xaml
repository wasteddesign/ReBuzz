<Window x:Class="BuzzGUI.MachineView.CPUMonitor.CPUMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CPU Monitor" Height="660" Width="790" MinWidth="520" MinHeight="360" WindowStyle="ToolWindow" ShowInTaskbar="False"
				UseLayoutRounding="True" TextOptions.TextFormattingMode="{Binding TextFormattingMode}" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
				Style="{DynamicResource ThemeWindowStyle}">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="8,6,8,8">
			<TextBlock Name="contextText" Opacity="0.7" HorizontalAlignment="Right" ToolTip="Audio settings these readings were taken with"/>
			<UniformGrid Columns="4" Margin="0,6,0,0">
				<Border BorderBrush="Gray" BorderThickness="1" Padding="8,6" Margin="0,0,6,0" ToolTip="Time spent inside the audio engine as a share of real time, smoothed">
					<StackPanel>
						<TextBlock Text="Engine load (average)" Opacity="0.7"/>
						<TextBlock Name="engineLoadText" Text="–" FontSize="20" FontWeight="SemiBold"/>
						<TextBlock Text="of real time" Opacity="0.7"/>
					</StackPanel>
				</Border>
				<Border BorderBrush="Gray" BorderThickness="1" Padding="8,6" Margin="3,0,3,0" ToolTip="The audio driver callback that came closest to (or went past) its own block period since the last reset. With the audio buffer fill thread on, the callback only copies audio that was rendered ahead of time.">
					<StackPanel>
						<TextBlock Text="Peak callback" Opacity="0.7"/>
						<TextBlock Name="peakCallbackText" Text="–" FontSize="20" FontWeight="SemiBold"/>
						<TextBlock Name="peakCallbackSubText" Text="waiting for audio" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
					</StackPanel>
				</Border>
				<Border BorderBrush="Gray" BorderThickness="1" Padding="8,6" Margin="3,0,3,0" ToolTip="Audio driver callbacks that took longer than their own block period since the last reset. Each one is a likely audible glitch.">
					<StackPanel>
						<TextBlock Text="Deadline misses" Opacity="0.7"/>
						<TextBlock Name="missesText" Text="0" FontSize="20" FontWeight="SemiBold"/>
						<TextBlock Name="missesSubText" Text="worst overrun: none" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
					</StackPanel>
				</Border>
				<Border BorderBrush="Gray" BorderThickness="1" Padding="8,6" Margin="6,0,0,0" ToolTip="Longest single Work call of any machine since the last reset. When this is far above the machines' own 99% figures, the audio threads were held up by something outside the machines, such as a garbage collection pause or the operating system's scheduler.">
					<StackPanel>
						<TextBlock Text="Longest stall" Opacity="0.7"/>
						<TextBlock Name="stallText" Text="–" FontSize="20" FontWeight="SemiBold"/>
						<TextBlock Text="in one Work call" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
					</StackPanel>
				</Border>
			</UniformGrid>
			<DockPanel Margin="0,8,0,0">
				<TextBlock Name="headroomText" DockPanel.Dock="Right"/>
				<TextBlock Text="Headroom at peak" Opacity="0.7"/>
			</DockPanel>
			<Grid Name="headroomTrack" Height="8" Margin="0,4,0,0" ToolTip="Fill: average engine load. Marker: peak callback as a share of its block period.">
				<Rectangle Fill="Gray" Opacity="0.3"/>
				<Rectangle Name="headroomFill" Fill="#5AA9FF" HorizontalAlignment="Left" Width="0"/>
				<Rectangle Name="headroomTick" Fill="#F0A13A" HorizontalAlignment="Left" Width="2" Margin="0,-2,0,-2" Visibility="Hidden"/>
			</Grid>
			<TextBlock Name="gcText" Margin="0,6,0,0" Opacity="0.7" ToolTip="Garbage collections in the ReBuzz process since the last reset, and the total time they kept all managed threads (including the audio threads) paused. Compare the average pause with the longest stall."/>
			<TextBlock Name="allocText" Margin="0,2,0,0" Opacity="0.7" ToolTip="How fast managed memory is being allocated. Allocation is what triggers garbage collection. The first figure is the whole ReBuzz process (engine, machines, GUI); the second is the part allocated inside machines' Work calls, listed per machine in the Alloc column."/>
		</StackPanel>

		<ListView Name="listView" Grid.Row="1">
			<ListView.View>
				<GridView>
					<GridView.Columns>
						<GridViewColumn Width="170">
							<GridViewColumnHeader Content="Machine" Click="SortClick" Tag="Name"/>
							<GridViewColumn.CellTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding DisplayName}" Opacity="{Binding RowOpacity}" TextTrimming="CharacterEllipsis"/>
								</DataTemplate>
							</GridViewColumn.CellTemplate>
						</GridViewColumn>
						<GridViewColumn Width="166">
							<GridViewColumnHeader Content="0–25% of chunk" Click="SortClick" Tag="CPUUsage" ToolTip="Fill: average. Marker: 99% of Work calls since the last reset were shorter than this. Both as a share of the time budget of one 256 sample chunk."/>
							<GridViewColumn.CellTemplate>
								<DataTemplate>
									<Grid Width="150" Height="8" HorizontalAlignment="Left" Opacity="{Binding RowOpacity}">
										<Rectangle Fill="Gray" Opacity="0.3"/>
										<Rectangle Fill="#5AA9FF" HorizontalAlignment="Left" Width="{Binding AvgBarWidth}"/>
										<Rectangle Fill="#F0A13A" HorizontalAlignment="Left" Width="2" Margin="{Binding PeakTickMargin}" Opacity="{Binding PeakTickOpacity}"/>
									</Grid>
								</DataTemplate>
							</GridViewColumn.CellTemplate>
						</GridViewColumn>
						<GridViewColumn Width="70">
							<GridViewColumnHeader Content="Avg %" Click="SortClick" Tag="CPUUsage" ToolTip="Time spent in this machine as a share of real time, smoothed"/>
							<GridViewColumn.CellTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding CPUUsageString}" Width="54" TextAlignment="Right" Opacity="{Binding RowOpacity}"/>
								</DataTemplate>
							</GridViewColumn.CellTemplate>
						</GridViewColumn>
						<GridViewColumn Width="80">
							<GridViewColumnHeader Content="Avg µs" Click="SortClick" Tag="AvgMicros" ToolTip="Average time per 256 samples of audio, in microseconds"/>
							<GridViewColumn.CellTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding AvgMicrosString}" Width="64" TextAlignment="Right" Opacity="{Binding RowOpacity}"/>
								</DataTemplate>
							</GridViewColumn.CellTemplate>
						</GridViewColumn>
						<GridViewColumn Width="80">
							<GridViewColumnHeader Content="99% µs" Click="SortClick" Tag="PeakMicros" ToolTip="99% of this machine's Work calls since the last reset were shorter than this many microseconds (approximate). Rare stalls that hit every machine do not show here. Bold when it is far above the average."/>
							<GridViewColumn.CellTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding PeakMicrosString}" Width="64" TextAlignment="Right" FontWeight="{Binding PeakFontWeight}" Opacity="{Binding RowOpacity}"/>
								</DataTemplate>
							</GridViewColumn.CellTemplate>
						</GridViewColumn>
						<GridViewColumn Width="90">
							<GridViewColumnHeader Content="Alloc KB/s" Click="SortClick" Tag="AllocRate" ToolTip="Managed memory allocated on the audio thread during this machine's Work calls, in kilobytes per second. A machine that allocates while it works makes garbage collections more frequent for everyone."/>
							<GridViewColumn.CellTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding AllocRateString}" Width="74" TextAlignment="Right" Opacity="{Binding RowOpacity}"/>
								</DataTemplate>
							</GridViewColumn.CellTemplate>
						</GridViewColumn>
					</GridView.Columns>
				</GridView>
			</ListView.View>
		</ListView>

		<DockPanel Grid.Row="2" Margin="8,6,8,6">
			<Button DockPanel.Dock="Right" Content="Copy as text" Padding="10,2" Margin="6,0,0,0" Click="CopyClick" ToolTip="Copy the current readings to the clipboard"/>
			<Button DockPanel.Dock="Right" Content="Reset peaks" Padding="10,2" Margin="6,0,0,0" Click="ResetClick" ToolTip="Clear the peak readings and the deadline miss count"/>
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
				<TextBlock Name="machinesText" ToolTip="Sum of the machines' CPU usage"/>
				<TextBlock Name="totalText" Margin="12,0,0,0" ToolTip="Total audio engine CPU usage including overhead"/>
				<TextBlock Name="overheadText" Margin="12,0,0,0" ToolTip="Multithreading off: CPU usage by non-machines (internal mixers, amplifiers, synchronization etc.). Multithreading on: machine time divided by engine time, which is how many audio threads' worth of work runs in parallel."/>
				<TextBlock Name="sinceText" Margin="12,0,0,0" Opacity="0.7"/>
			</StackPanel>
		</DockPanel>
	</Grid>
</Window>
