<UserControl x:Class="BuzzGUI.MetadataControl.MetadataEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:l="clr-namespace:BuzzGUI.MetadataControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MinWidth="350" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <Grid HorizontalAlignment="Stretch">
            <Grid HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Metadata Editor" FontSize="14" HorizontalAlignment="Center" Margin="4, 4, 0, 10"/>
                <TextBlock Grid.Row="1" Text="Image Data" FontSize="14" HorizontalAlignment="Center" Margin="4, 24, 0, 12"/>
                <Grid Grid.Row="2" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListView ItemsSource="{Binding MetadataImageItems}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <ListView.Resources>
                            <Style TargetType="{x:Type GridViewColumnHeader}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#222" BorderThickness="1" Margin="4">
                                                <Image Source="{Binding ImageSourceData}" Stretch="Fill" Margin="0" Width="140" Height="140" />
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" HorizontalAlignment="Center" FontSize="12" Text="Description" Margin="0"/>
                                                <TextBox Grid.Row="1" Text="{Binding Name,
                                                    UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" Width="180" Margin="0,4,0,4"/>
                                                <ComboBox Grid.Row="2"
                                                  ItemsSource="{Binding AvailableImageTypes}"
                                                  SelectedItem="{Binding ImageType, Mode=TwoWay}"
                                                  Width="180"
                                                  Margin="0,4,0,4"/>
                                                <WrapPanel Grid.Row="3">
                                                    <Menu  Margin="0, 4, 0, 2" IsEnabled="{Binding IsValidAudioFile}" FontSize="12">
                                                        <MenuItem Header="_Image" SubmenuOpened="ImageMenuOpened" Height="24" >
                                                            <MenuItem Header="_Load" Command="{Binding LoadImageCommand}"/>
                                                            <MenuItem Header="_Delete"
                                                                  Command="{Binding DataContext.DeleteImageCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                  CommandParameter="{Binding}" />
                                                            <Separator/>
                                                        </MenuItem>
                                                    </Menu>
                                                </WrapPanel>

                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Grid Grid.Row="1">
                        <Button Content="Add Image" Command="{Binding AddImageCommand}" IsEnabled="{Binding IsValidAudioFile}" Width="100" Margin="0, 4, 4, 0"/>
                    </Grid>
                </Grid>
                <TextBlock Grid.Row="3" Text="Standard Metadata" FontSize="14" HorizontalAlignment="Center" Margin="4, 24, 0, 12"/>
                <ListView Grid.Row="4" ItemsSource="{Binding MetadataItems}" HorizontalAlignment="Stretch">
                    <ListView.Resources>
                        <Style TargetType="{x:Type GridViewColumnHeader}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="2">
                                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" Margin="0" Width="146">
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Value" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Value,
                                                UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Value}" Margin="0" Width="186" IsEnabled="{Binding IsEnabled}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock Grid.Row="5" Text="Custom Metadata" FontSize="14" HorizontalAlignment="Center" Margin="4, 24, 0, 12"/>
                <Grid Grid.Row="6" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListView Grid.Row="0" ItemsSource="{Binding MetadataCustomItems}" HorizontalAlignment="Stretch">
                        <ListView.Resources>
                            <Style TargetType="{x:Type GridViewColumnHeader}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Custom Name" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Name}" Margin="0" Width="136">
                                                <TextBox.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Delete"
                                Command="{Binding DataContext.DeleteMetadataCommand,
                                                RelativeSource={RelativeSource AncestorType=ListView}}"
                                CommandParameter="{Binding}" />
                                                    </ContextMenu>
                                                </TextBox.ContextMenu>
                                            </TextBox>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Value" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Value,
                                                UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Value}" Margin="0" Width="186"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Grid Grid.Row="1">
                        <Button Content="Add Field" Command="{Binding AddCustomFieldCommand}" IsEnabled="{Binding IsValidAudioFile}" Width="100" Margin="0, 4, 4, 0"/>
                    </Grid>
                </Grid> 
                <Button Grid.Row="7" Content="Save" Command="{Binding SaveCustomMetadataCommand}" IsEnabled="{Binding IsValidAudioFile}" Width="100" Margin="0, 24, 4, 0"/>
            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>
